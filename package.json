{
  "name": "trust-system",
  "version": "2.0.0",
  "private": true,
  "description": "Trust Lines D.S.B — frontend (Vite/React) + API (NestJS on Vercel Functions), Postgres + Realtime on Supabase",
  "scripts": {
    "dev": "vite",
    "dev:server": "cd server && nest start --watch",
    "build": "npm run build:server && npm run build:web",
    "build:web": "tsc -p tsconfig.json && vite build",
    "build:server": "prisma generate --schema server/prisma/schema.prisma && tsc -p server/tsconfig.build.json",
    "preview": "vite preview",
    "prisma:push": "prisma db push --schema server/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema server/prisma/schema.prisma",
    "postinstall": "prisma generate --schema server/prisma/schema.prisma"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/mapped-types": "^2.0.5",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.4",
    "@nestjs/schedule": "^6.1.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/client": "^5.22.0",
    "@sparticuz/chromium": "^138.0.2",
    "@supabase/supabase-js": "^2.58.0",
    "@vercel/functions": "^2.2.0",
    "bcrypt": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.6",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "file-saver": "^2.0.5",
    "helmet": "^8.1.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.563.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^7.0.12",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "puppeteer-core": "^24.22.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.12.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/file-saver": "^2.0.7",
    "@types/lodash": "^4.17.23",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.17.6",
    "@types/nodemailer": "^7.0.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "prisma": "^5.22.0",
    "puppeteer": "^24.22.0",
    "typescript": "^5.6.3",
    "vite": "^4.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
