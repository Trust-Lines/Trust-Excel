# ─────────────────────────────────────────────────────────────
# Trust System — environment variables
# Local: copy to server/.env.  Vercel: add each one under
# Project → Settings → Environment Variables.
# ─────────────────────────────────────────────────────────────

# Database — Supabase (Project → Connect → ORMs → Prisma)
# App traffic: transaction pooler (6543, pgbouncer)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Schema changes (prisma db push): session pooler (5432)
DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Supabase — Realtime (live sync) + Storage (daily backups)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...            # server only, never expose to the browser
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...  # handed to logged-in clients by /api/realtime/config
REALTIME_CHANNEL_SECRET=<random string>      # prefix of every realtime channel name
BACKUP_BUCKET=backups

# Vercel Cron (Vercel sends "Authorization: Bearer $CRON_SECRET")
CRON_SECRET=<random string>

# Frontend → API (on Vercel the build uses same-origin /api automatically)
VITE_API_URL=http://localhost:3001/api

# JWT
JWT_SECRET=<random string>
REFRESH_TTL_SHORT=86400
REFRESH_TTL_LONG=604800

# App
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173   # extra allowed CORS origins, comma separated

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_ATTEMPTS=100

# SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Permissions V2
PERMISSIONS_V2_MODE=off
PERMISSIONS_V2_LOG_DECISIONS=true
PERMISSIONS_V2_ENABLED_TABLES=operational-board-grid
PERMISSIONS_V2_ENABLED_USERS=
ADMIN_ALERT_EMAIL=

# Dropbox
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
APP_NAME=Trust-System

# Install without downloading full Chrome (Vercel uses @sparticuz/chromium)
PUPPETEER_SKIP_DOWNLOAD=true
