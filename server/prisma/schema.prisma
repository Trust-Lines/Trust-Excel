generator client {
  provider      = "prisma-client-js"
  // native = local dev; rhel-openssl-3.0.x = Vercel Functions (Node 20/22, Amazon Linux 2023)
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  // Supabase transaction pooler (port 6543, ?pgbouncer=true) — what the serverless API uses at runtime
  url       = env("DATABASE_URL")
  // Supabase session pooler (port 5432) — used by prisma db push / migrations
  directUrl = env("DIRECT_URL")
}

model User {
  id                    String                     @id @default(cuid())
  email                 String                     @unique
  name                  String?
  passwordHash          String
  roleId                String
  isActive              Boolean                    @default(true)
  createdAt             DateTime                   @default(now())
  updatedAt             DateTime                   @updatedAt
  forcePasswordChange   Boolean                    @default(true)
  invitedAt             DateTime?
  lastLoginAt           DateTime?
  lastActiveAt          DateTime?
  username              String?                    @unique
  deletedAt             DateTime?
  directOrderChangeLogs DirectOrderItemChangeLog[] @relation("DirectOrderChangeLogUser")
  createdDirectOrders   DirectOrderProject[]       @relation("DirectOrderCreator")
  inviteTokens          InviteToken[]
  createdProjects       Project[]                  @relation("ProjectCreator")
  refreshTokens         RefreshToken[]
  userAccessPolicy      UserAccessPolicy?
  role                  Role                       @relation(fields: [roleId], references: [id])
  todayPfFlags          TodayPfFlag[]
  pfGroups              PfGroup[]
  pfGroupMembers        PfGroupMember[]

  @@index([deletedAt])
  @@map("users")
}

model LoginAttempt {
  id         String   @id @default(cuid())
  ip         String
  identifier String
  success    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([ip, identifier, createdAt])
  @@index([createdAt])
  @@map("login_attempts")
}

model Role {
  id                   String                 @id @default(cuid())
  name                 String                 @unique
  isSystem             Boolean                @default(false)
  isActive             Boolean                @default(true)
  projectScopeEnabled  Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  pagePermissions      Json?
  roleColumnVisibility RoleColumnVisibility[]
  rolePageAccess       RolePageAccess[]
  rolePermissions      RolePermission[]
  roleProjectScope     RoleProjectScope[]
  roleTableAccess      RoleTableAccess[]
  roleTypeVisibility   RoleTypeVisibility[]
  users                User[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(cuid())
  key             String           @unique
  module          String
  action          String
  createdAt       DateTime         @default(now())
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model RoleColumnVisibility {
  id               String         @id @default(cuid())
  roleId           String
  columnKey        String
  isHidden         Boolean        @default(false)
  isReadOnly       Boolean        @default(false)
  requiresApproval Boolean        @default(false)
  tableId          String?
  role             Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  table            TableRegistry? @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([roleId, tableId, columnKey])
  @@index([roleId])
  @@map("role_column_visibility")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String
  revokedAt DateTime?
  expiresAt DateTime
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model InviteToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invite_tokens")
}

model UserAccessPolicy {
  id                String   @id @default(cuid())
  userId            String   @unique
  modulePermissions Json?
  columnsHidden     String[] @default([])
  columnsReadOnly   String[] @default([])
  rowScopes         Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  pagePermissions   Json?
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_access_policies")
}

model Vendor {
  id                        String                      @id @default(cuid())
  code                      String
  name                      String
  isActive                  Boolean                     @default(true)
  createdAt                 DateTime                    @default(now())
  updatedAt                 DateTime                    @updatedAt
  fixedMillworkCodes        Boolean                     @default(false) // Millwork PF codes use the fixed M01/M02/M03 rule by order type
  SupplierProfile           SupplierProfile?
  directOrderItems          DirectOrderItem[]
  expensesDirectOrderItems  ExpensesDirectOrderItem[]
  expensesMissingExtraItems ExpensesMissingExtraItem[]
  expensesPItems            ExpensesPItem[]
  missingExtraItems         MissingExtraItem[]
  projectItems              ProjectItem[]
  invoiceReceiptRows        SupplierInvoiceReceiptRow[]
  trustExpenseItems         TrustExpenseItem[]

  @@index([isActive])
  @@index([code])
  @@map("vendors")
}

model OrderType {
  id               String            @id @default(cuid())
  name             String
  isActive         Boolean           @default(true)
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  directOrderItems DirectOrderItem[]
  projectItems     ProjectItem[]

  @@index([isActive])
  @@map("order_types")
}

model Project {
  id                String                 @id @default(cuid())
  bucket            ProjectBucket
  projectNo         String                 @default("P001")
  name              String
  address           String
  description       String?
  types             String[]               @default([])
  status            ProjectStatus          @default(PRE_PROJECT)
  createdByUserId   String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  containerDate     DateTime?
  isUrgent          Boolean                @default(false)
  deletedAt         DateTime?
  dropboxSection    String?
  dropboxRegion     String?
  dropboxStatus     String?
  dropboxClientType String?
  clientName        String?
  dropboxPath       String?
  logoUrl           String?
  halfOfYear        ProjectHalf?
  halfYear          Int?
  missingExtraCases MissingExtraCase[]
  changeLogs        ProjectItemChangeLog[]
  items             ProjectItem[]
  priceListEntries  PriceListEntry[]
  todayPfFlags      TodayPfFlag[]
  pfGroupMembers    PfGroupMember[]
  createdBy         User?                  @relation("ProjectCreator", fields: [createdByUserId], references: [id])

  @@unique([projectNo, bucket])
  @@index([bucket])
  @@index([status])
  @@index([createdAt])
  @@index([createdByUserId])
  @@index([projectNo])
  @@index([deletedAt])
  @@index([halfYear, halfOfYear])
  @@map("projects")
}

model ProjectItem {
  id                   String                 @id @default(cuid())
  todayPfFlags         TodayPfFlag[]
  projectId            String
  type                 ProjectItemType?
  pfCode               String?
  vendorId             String?
  orderTypeId          String?
  orderType            String?
  pfSignStatus         SignStatus             @default(NOT_SIGNED)
  poSignStatus         SignStatus             @default(NOT_SIGNED)
  status               ItemStatus?
  std                  DateTime?
  etd                  DateTime?
  rtd                  DateTime?
  ftd                  DateTime?
  containerNo          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  pfTl                 Decimal?               @db.Decimal(12, 2)
  pfUsd                Decimal?               @db.Decimal(12, 2)
  rtr                  DateTime?
  paidTl1              Decimal?               @db.Decimal(12, 2)
  paidTl2              Decimal?               @db.Decimal(12, 2)
  paidUsd1             Decimal?               @db.Decimal(12, 2)
  paidUsd2             Decimal?               @db.Decimal(12, 2)
  paymentRule          String?
  customTypeId         String?
  containerDate        DateTime?
  invoiceNumber        String?
  invoiceTransactionNo String?
  quickBook            String?
  rdy                  DateTime?
  snd                  DateTime?
  containerId          String?
  duePaid              Boolean                @default(false)
  paidUsd1Date         DateTime?
  paidUsd2Date         DateTime?
  paidTl1Date          DateTime?
  paidTl2Date          DateTime?
  invoiceDate          DateTime?
  invoice              Decimal?               @db.Decimal(12, 2)
  invoiceTl            Decimal?               @db.Decimal(12, 2)
  statusNote           String?
  deletedAt            DateTime?
  sourcePriceListId    String?
  priceListCode        String?
  description          String?
  priceNotes           Json?
  changeLogs           ProjectItemChangeLog[]
  container            Container?             @relation(fields: [containerId], references: [id])
  customType           CustomProjectType?     @relation(fields: [customTypeId], references: [id])
  orderTypeRef         OrderType?             @relation(fields: [orderTypeId], references: [id])
  project              Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor               Vendor?                @relation(fields: [vendorId], references: [id])

  @@index([projectId])
  @@index([type])
  @@index([customTypeId])
  @@index([vendorId])
  @@index([orderTypeId])
  @@index([containerId])
  @@index([deletedAt])
  @@map("project_items")
}

model ProjectItemChangeLog {
  id              String      @id @default(cuid())
  projectId       String
  projectItemId   String
  changedByUserId String?
  field           String
  oldValue        String?
  newValue        String?
  createdAt       DateTime    @default(now())
  project         Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectItem     ProjectItem @relation(fields: [projectItemId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectItemId])
  @@index([field])
  @@index([createdAt])
  @@map("project_item_change_logs")
}

model MissingExtraCase {
  id                 String             @id @default(cuid())
  baseProjectId      String?
  baseProjectNo      String
  baseProjectName    String
  section            ProjectBucket
  caseType           CaseType
  caseIndex          Int
  derivedProjectCode String             @unique
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  types              String[]           @default([])
  containerDate      DateTime?
  isUrgent           Boolean            @default(false)
  deletedAt          DateTime?
  halfOfYear         ProjectHalf?
  halfYear           Int?
  baseProject        Project?           @relation(fields: [baseProjectId], references: [id])
  items              MissingExtraItem[]

  @@index([baseProjectNo])
  @@index([section])
  @@index([caseType])
  @@index([derivedProjectCode])
  @@index([deletedAt])
  @@index([halfYear, halfOfYear])
  @@map("missing_extra_cases")
}

model MissingExtraItem {
  id                   String             @id @default(cuid())
  caseId               String
  type                 ProjectItemType?
  pfCode               String?
  vendorId             String?
  orderType            String?
  poSignStatus         SignStatus?
  pfSignStatus         SignStatus?
  status               ItemStatus?
  std                  DateTime?
  etd                  DateTime?
  rtd                  DateTime?
  rtr                  DateTime?
  ftd                  DateTime?
  containerNo          String?
  pfUsd                Decimal?           @db.Decimal(12, 2)
  pfTl                 Decimal?           @db.Decimal(12, 2)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  paymentRule          String?
  paidTl1              Decimal?           @db.Decimal(12, 2)
  paidTl2              Decimal?           @db.Decimal(12, 2)
  paidUsd1             Decimal?           @db.Decimal(12, 2)
  paidUsd2             Decimal?           @db.Decimal(12, 2)
  customTypeId         String?
  containerDate        DateTime?
  invoiceNumber        String?
  invoiceTransactionNo String?
  quickBook            String?
  rdy                  DateTime?
  snd                  DateTime?
  containerId          String?
  duePaid              Boolean            @default(false)
  paidUsd1Date         DateTime?
  paidUsd2Date         DateTime?
  paidTl1Date          DateTime?
  paidTl2Date          DateTime?
  invoiceDate          DateTime?
  invoice              Decimal?           @db.Decimal(12, 2)
  invoiceTl            Decimal?           @db.Decimal(12, 2)
  statusNote           String?
  deletedAt            DateTime?
  priceNotes           Json?
  case                 MissingExtraCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  container            Container?         @relation(fields: [containerId], references: [id])
  customType           CustomProjectType? @relation(fields: [customTypeId], references: [id])
  vendor               Vendor?            @relation(fields: [vendorId], references: [id])

  @@index([caseId])
  @@index([type])
  @@index([customTypeId])
  @@index([vendorId])
  @@index([containerId])
  @@index([status])
  @@index([deletedAt])
  @@map("missing_extra_items")
}

model PaymentRuleMaster {
  id        String   @id @default(cuid())
  value     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("payment_rule_master")
}

model CustomProjectType {
  id                        String                     @id @default(cuid())
  name                      String                     @unique
  code                      String                     @unique
  description               String?
  isGlobal                  Boolean                    @default(true)
  isActive                  Boolean                    @default(true)
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  directOrderItems          DirectOrderItem[]
  expensesDirectOrderItems  ExpensesDirectOrderItem[]
  expensesMissingExtraItems ExpensesMissingExtraItem[]
  expensesPItems            ExpensesPItem[]
  missingExtraItems         MissingExtraItem[]
  projectItems              ProjectItem[]
  roleTypeVisibility        RoleTypeVisibility[]
  trustExpenseItems         TrustExpenseItem[]
  todayPfFlags              TodayPfFlag[]
  pfGroupMembers            PfGroupMember[]

  @@index([isGlobal])
  @@index([isActive])
  @@map("custom_project_types")
}

model TodayPfFlag {
  id              String             @id @default(cuid())
  projectId       String
  type            ProjectItemType?
  customTypeId    String?
  createdByUserId String?
  createdAt       DateTime           @default(now())
  completedAt     DateTime?
  kind            String             @default("PF") // "PF" = PFs to finish, "ORDER" = PFs to order
  itemId          String? // ORDER flags target ONE specific PF (project item); PF flags leave this null
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customType      CustomProjectType? @relation(fields: [customTypeId], references: [id])
  createdBy       User?              @relation(fields: [createdByUserId], references: [id])
  item            ProjectItem?       @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@unique([kind, itemId])
  @@index([projectId])
  @@index([completedAt])
  @@map("today_pf_flags")
}

model PfGroup {
  id              String          @id @default(cuid())
  number          Int             // Sequential display number: "Group 1", "Group 2", ...
  createdByUserId String?
  createdAt       DateTime        @default(now())
  createdBy       User?           @relation(fields: [createdByUserId], references: [id])
  members         PfGroupMember[]

  @@index([number])
  @@map("pf_groups")
}

model PfGroupMember {
  id              String             @id @default(cuid())
  groupId         String
  projectId       String
  type            ProjectItemType?
  customTypeId    String?
  rank            Int                // Order within the group, 1-based, kept contiguous
  createdByUserId String?
  createdAt       DateTime           @default(now())
  group           PfGroup            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  project         Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  customType      CustomProjectType? @relation(fields: [customTypeId], references: [id])
  createdBy       User?              @relation(fields: [createdByUserId], references: [id])

  @@unique([groupId, projectId, type, customTypeId])
  @@index([groupId])
  @@index([projectId])
  @@map("pf_group_members")
}

model DirectOrderProject {
  id              String                     @id @default(cuid())
  bucket          ProjectBucket
  projectNo       String                     @default("DO-001")
  name            String
  address         String
  description     String?
  types           String[]                   @default([])
  status          ProjectStatus              @default(PRE_PROJECT)
  createdByUserId String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  containerDate   DateTime?
  isUrgent        Boolean                    @default(false)
  deletedAt       DateTime?
  halfOfYear      ProjectHalf?
  halfYear        Int?
  changeLogs      DirectOrderItemChangeLog[]
  items           DirectOrderItem[]
  createdBy       User?                      @relation("DirectOrderCreator", fields: [createdByUserId], references: [id])

  @@unique([projectNo, bucket])
  @@index([bucket])
  @@index([status])
  @@index([createdAt])
  @@index([createdByUserId])
  @@index([projectNo])
  @@index([deletedAt])
  @@index([halfYear, halfOfYear])
  @@map("direct_order_projects")
}

model DirectOrderItem {
  id                   String                     @id @default(cuid())
  projectId            String
  type                 ProjectItemType?
  customTypeId         String?
  pfCode               String?
  vendorId             String?
  orderTypeId          String?
  orderType            String?
  pfSignStatus         SignStatus?
  poSignStatus         SignStatus?
  status               ItemStatus?
  std                  DateTime?
  etd                  DateTime?
  rtd                  DateTime?
  ftd                  DateTime?
  containerNo          String?
  paymentRule          String?
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt
  pfTl                 Decimal?                   @db.Decimal(12, 2)
  pfUsd                Decimal?                   @db.Decimal(12, 2)
  paidUsd1             Decimal?                   @db.Decimal(12, 2)
  paidUsd2             Decimal?                   @db.Decimal(12, 2)
  paidTl1              Decimal?                   @db.Decimal(12, 2)
  paidTl2              Decimal?                   @db.Decimal(12, 2)
  rtr                  DateTime?
  containerDate        DateTime?
  invoiceNumber        String?
  invoiceTransactionNo String?
  quickBook            String?
  rdy                  DateTime?
  snd                  DateTime?
  containerId          String?
  duePaid              Boolean                    @default(false)
  paidUsd1Date         DateTime?
  paidUsd2Date         DateTime?
  paidTl1Date          DateTime?
  paidTl2Date          DateTime?
  invoiceDate          DateTime?
  invoice              Decimal?                   @db.Decimal(12, 2)
  invoiceTl            Decimal?                   @db.Decimal(12, 2)
  statusNote           String?
  deletedAt            DateTime?
  priceNotes           Json?
  changeLogs           DirectOrderItemChangeLog[]
  container            Container?                 @relation(fields: [containerId], references: [id])
  customType           CustomProjectType?         @relation(fields: [customTypeId], references: [id])
  orderTypeRef         OrderType?                 @relation(fields: [orderTypeId], references: [id])
  project              DirectOrderProject         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor               Vendor?                    @relation(fields: [vendorId], references: [id])

  @@index([projectId])
  @@index([type])
  @@index([customTypeId])
  @@index([vendorId])
  @@index([orderTypeId])
  @@index([containerId])
  @@index([deletedAt])
  @@map("direct_order_items")
}

model DirectOrderItemChangeLog {
  id              String             @id @default(cuid())
  projectId       String
  projectItemId   String
  changedByUserId String?
  field           String
  oldValue        String?
  newValue        String?
  createdAt       DateTime           @default(now())
  changedBy       User?              @relation("DirectOrderChangeLogUser", fields: [changedByUserId], references: [id])
  project         DirectOrderProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectItem     DirectOrderItem    @relation(fields: [projectItemId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectItemId])
  @@index([changedByUserId])
  @@index([createdAt])
  @@map("direct_order_item_change_logs")
}

model Container {
  id                        String                     @id @default(cuid())
  name                      String                     @unique
  createdAt                 DateTime                   @default(now())
  updatedAt                 DateTime                   @updatedAt
  directOrderItems          DirectOrderItem[]
  expensesDirectOrderItems  ExpensesDirectOrderItem[]
  expensesMissingExtraItems ExpensesMissingExtraItem[]
  expensesPItems            ExpensesPItem[]
  missingExtraItems         MissingExtraItem[]
  projectItems              ProjectItem[]
  trustExpenseItems         TrustExpenseItem[]

  @@map("containers_master")
}

model SupplierProfile {
  id           String    @id @default(cuid())
  vendorId     String    @unique
  companyName  String?
  bankName     String?
  iban         String?
  officialName String?
  noteDate     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  vendor       Vendor    @relation(fields: [vendorId], references: [id], onDelete: Cascade)
}

model SupplierInvoiceReceiptRow {
  id            String   @id @default(cuid())
  vendorId      String
  region        String
  transactionNo String   @default("")
  invoiceNumber String   @default("")
  quickBook     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  itemId        String   @unique
  mode          String
  vendor        Vendor   @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  @@index([vendorId, region])
  @@map("supplier_invoice_receipt_rows")
}

model TrustExpenseProject {
  id            String             @id @default(cuid())
  bucket        ProjectBucket
  projectNo     String             @default("TE-001")
  name          String
  address       String
  description   String?
  types         String[]           @default([])
  status        ProjectStatus      @default(PRE_PROJECT)
  isUrgent      Boolean            @default(false)
  containerDate DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  deletedAt     DateTime?
  items         TrustExpenseItem[]

  @@unique([projectNo, bucket])
  @@index([bucket])
  @@index([status])
  @@index([createdAt])
  @@index([projectNo])
  @@index([deletedAt])
  @@map("trust_expense_projects")
}

model TrustExpenseItem {
  id                   String              @id @default(cuid())
  projectId            String
  type                 ProjectItemType?
  customTypeId         String?
  vendorId             String?
  orderType            String?
  status               ItemStatus?
  std                  DateTime?
  etd                  DateTime?
  rtrd                 DateTime?
  ftd                  DateTime?
  expensesUsd          Decimal?            @db.Decimal(12, 2)
  expensesTl           Decimal?            @db.Decimal(12, 2)
  shelvesLocation      String?
  containerNo          String?
  invoice              String?
  colorHex             String?
  sortOrder            Int                 @default(0)
  teType               String?
  paidUsd1             Decimal?            @db.Decimal(12, 2)
  paidUsd2             Decimal?            @db.Decimal(12, 2)
  paidTl1              Decimal?            @db.Decimal(12, 2)
  paidTl2              Decimal?            @db.Decimal(12, 2)
  invoiceTransactionNo String?
  invoiceNumber        String?
  quickBook            String?
  paymentRule          String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  rdy                  DateTime?
  snd                  DateTime?
  containerId          String?
  deletedAt            DateTime?
  container            Container?          @relation(fields: [containerId], references: [id])
  customType           CustomProjectType?  @relation(fields: [customTypeId], references: [id])
  project              TrustExpenseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  vendor               Vendor?             @relation(fields: [vendorId], references: [id])

  @@index([projectId])
  @@index([type])
  @@index([customTypeId])
  @@index([vendorId])
  @@index([containerId])
  @@index([sortOrder])
  @@index([deletedAt])
  @@map("trust_expense_items")
}

model PageRegistry {
  id             String           @id @default(cuid())
  key            String           @unique
  name           String
  description    String?
  parentId       String?
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  parent         PageRegistry?    @relation("PageHierarchy", fields: [parentId], references: [id])
  children       PageRegistry[]   @relation("PageHierarchy")
  rolePageAccess RolePageAccess[]
  tables         TableRegistry[]

  @@map("page_registry")
}

model TableRegistry {
  id                   String                 @id @default(cuid())
  key                  String                 @unique
  name                 String
  description          String?
  pageId               String?
  isActive             Boolean                @default(true)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  roleColumnVisibility RoleColumnVisibility[]
  roleTableAccess      RoleTableAccess[]
  page                 PageRegistry?          @relation(fields: [pageId], references: [id])

  @@map("table_registry")
}

model ColumnRegistry {
  id                  String   @id @default(cuid())
  key                 String   @unique
  name                String
  description         String?
  dataType            String?
  group               String?
  isGlobal            Boolean  @default(true)
  isMoney             Boolean  @default(false)
  width               Int?
  isEditableByDefault Boolean  @default(true)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("column_registry")
}

model ActionRegistry {
  id              String            @id @default(cuid())
  key             String            @unique
  name            String
  description     String?
  category        String?
  parentId        String?
  isActive        Boolean           @default(true)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  parent          ActionRegistry?   @relation("ActionHierarchy", fields: [parentId], references: [id])
  children        ActionRegistry[]  @relation("ActionHierarchy")
  roleTableAccess RoleTableAccess[]

  @@map("action_registry")
}

model RolePageAccess {
  id        String       @id @default(cuid())
  roleId    String
  pageId    String
  hasAccess Boolean      @default(true)
  page      PageRegistry @relation(fields: [pageId], references: [id], onDelete: Cascade)
  role      Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, pageId])
  @@map("role_page_access")
}

model RoleTableAccess {
  id        String         @id @default(cuid())
  roleId    String
  tableId   String
  actionId  String
  hasAccess Boolean        @default(true)
  action    ActionRegistry @relation(fields: [actionId], references: [id], onDelete: Cascade)
  role      Role           @relation(fields: [roleId], references: [id], onDelete: Cascade)
  table     TableRegistry  @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@unique([roleId, tableId, actionId])
  @@map("role_table_access")
}

model RoleTypeVisibility {
  id           String             @id @default(cuid())
  roleId       String
  typeEnum     ProjectItemType?
  customTypeId String?
  createdAt    DateTime           @default(now())
  customType   CustomProjectType? @relation(fields: [customTypeId], references: [id], onDelete: Cascade)
  role         Role               @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, typeEnum, customTypeId])
  @@index([roleId])
  @@map("role_type_visibility")
}

model RoleProjectScope {
  id         String   @id @default(cuid())
  roleId     String
  projectId  String
  sourceType String   @default("project")
  createdAt  DateTime @default(now())
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, projectId, sourceType])
  @@index([roleId])
  @@index([projectId])
  @@map("role_project_scope")
}

model AuditLog {
  id         String   @id @default(cuid())
  domain     String
  entityId   String
  entityType String
  projectRef String?
  field      String
  oldValue   String?
