model PriceListEntry {
  id              String                @id @default(cuid())
  projectId       String
  type            String
  version         Int?
  formData        Json                  @default("{}")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  createdByUserId String?
  project         Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvals       PriceListApproval[]

  @@index([projectId])
  @@index([type])
  @@map("price_list_entries")
}

model PriceListApproval {
  id               String    @id @default(cuid())
  priceListEntryId String    @map("price_list_entry_id")
  role             String
  userId           String?   @map("user_id")
  status           String    @default("pending")
  note             String?
  signedAt         DateTime? @map("signed_at")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  entry            PriceListEntry @relation(fields: [priceListEntryId], references: [id], onDelete: Cascade)

  @@index([priceListEntryId])
  @@index([role, status])
  @@index([userId])
  @@map("price_list_approvals")
}

model PriceListLookup {
  id        String   @id @default(cuid())
  field     String
  value     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([field, value])
  @@index([field])
  @@map("price_list_lookups")
}
